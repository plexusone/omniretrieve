{
  "irVersion": "1.0",
  "project": "omniretrieve",
  "repository": "github.com/plexusone/omniretrieve",
  "versioning": "semver",
  "commitConvention": "conventional",
  "releases": [
    {
      "version": "0.2.0",
      "date": "2026-05-17",
      "highlights": [
        { "description": "Module renamed from `github.com/agentplexus/omniretrieve` to `github.com/plexusone/omniretrieve`" }
      ],
      "changed": [
        { "description": "Rename module path from `github.com/agentplexus/omniretrieve` to `github.com/plexusone/omniretrieve`", "commit": "ee645c4" }
      ],
      "fixed": [
        { "description": "`generateID()` moved to OS-agnostic ID generation using `oscompat`", "commit": "d8fe2a0" }
      ],
      "documentation": [
        { "description": "Update README title", "commit": "562ae76" },
        { "description": "Update README shields", "commit": "96bb29d" }
      ],
      "dependencies": [
        { "description": "Bump `github.com/grokify/oscompat` from 0.1.0 to 0.3.0", "commit": "6f29ae3" }
      ],
      "internal": [
        { "description": "Update CI workflows to shared workflow filenames", "commit": "b951726" },
        { "description": "Update CI workflows to shared configurations", "commit": "0331451" }
      ]
    },
    {
      "version": "0.1.0",
      "date": "2026-01-11",
      "highlights": [
        { "description": "Initial release of OmniRetrieve - a unified retrieval library for Go" },
        { "description": "Support for Vector RAG, Graph RAG, and Hybrid retrieval strategies" }
      ],
      "added": [
        { "description": "Core retrieval interfaces (`Retriever`, `Query`, `Result`, `ContextItem`)" },
        { "description": "Vector retrieval with `Index`, `BatchIndex`, and `IndexManager` interfaces" },
        { "description": "Graph retrieval with `KnowledgeGraph` and `GraphManager` interfaces" },
        { "description": "Hybrid retrieval with configurable policies (`Parallel`, `VectorThenGraph`, `GraphThenVector`)" },
        { "description": "Observability support with span tracing (Phoenix, Opik, Langfuse compatible)" },
        { "description": "Reranking support (`CrossEncoder`, `Heuristic`, `Chain`)" },
        { "description": "In-memory implementations for testing (`VectorIndex`, `KnowledgeGraph`, `HashEmbedder`)" },
        { "description": "pgvector provider with HNSW/IVFFlat index types" },
        { "description": "Batch operations via COPY and multi-row INSERT" },
        { "description": "JSONB metadata filtering support" }
      ],
      "documentation": [
        { "description": "Add README with quick start guide and examples" },
        { "description": "Add PRD (Product Requirements Document)" },
        { "description": "Add TRD (Technical Requirements Document)" }
      ],
      "internal": [
        { "description": "Add GitHub Actions CI for multi-module testing" },
        { "description": "Add GitHub Actions lint workflow with golangci-lint" },
        { "description": "Add CodeQL security analysis" },
        { "description": "Add golangci-lint configuration" }
      ]
    }
  ]
}
